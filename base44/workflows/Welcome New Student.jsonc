{
  "description": "When a StudentRecord is created, posts a system welcome notification directing the student to set goals and meet Bud.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "StudentRecord"
    }
  },
  "name": "Welcome New Student",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "welcome_new_student",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "welcome": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "welcomeNewStudent",
            "args": {
              "student_id": "${ .trigger.entity_id }",
              "full_name": "${ .trigger.data.full_name }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send welcome",
            "description": "New StudentRecord created"
          }
        }
      }
    ]
  }
}