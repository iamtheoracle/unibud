{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "study_group_message_notifications",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "bridge_message_event": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "studyGroupEventBridge",
            "args": {
              "entity_name": "StudyGroupMessage",
              "event_type": "${ .trigger.event_type }",
              "entity_id": "${ .trigger.entity_id }",
              "data": "${ .trigger.data }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Bridge message event to notifications",
            "description": "Notify all group members except the sender"
          }
        }
      }
    ]
  },
  "name": "Study Group Message Notifications",
  "description": "Bridges StudyGroupMessage create events into the Spark Notification Engine via the studyGroupEventBridge backend function.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "StudyGroupMessage"
    }
  }
}