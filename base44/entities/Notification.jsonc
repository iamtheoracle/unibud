{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "academic",
        "social",
        "opportunity",
        "system",
        "emergency",
        "reminder",
        "achievement",
        "task",
        "comment",
        "mention",
        "reply",
        "message",
        "bud",
        "campus",
        "marketplace",
        "library",
        "transport",
        "timetable"
      ],
      "default": "system"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "link": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "Target user. Null = broadcast visible to all users."
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "normal",
        "low",
        "silent"
      ],
      "default": "normal",
      "description": "Spark priority. Silent never interrupts study."
    },
    "category": {
      "type": "string",
      "enum": [
        "system",
        "bud",
        "study_group",
        "assignment",
        "campus",
        "opportunity",
        "achievement",
        "social",
        "emergency"
      ],
      "default": "system"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "dismissed": {
      "type": "boolean",
      "default": false
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "open_count": {
      "type": "number",
      "default": 0
    },
    "batch_key": {
      "type": "string",
      "description": "Stable key for merging repetitive notifications."
    },
    "batch_count": {
      "type": "number",
      "default": 1
    },
    "source": {
      "type": "string",
      "description": "Spark module that raised the event (StudyGroup, Bud, System\u2026)."
    },
    "action": {
      "type": "string",
      "description": "Canonical Spark event name that generated this notification."
    }
  },
  "required": [
    "title",
    "message"
  ]
}