{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "academic",
        "social",
        "opportunity",
        "system",
        "emergency",
        "reminder",
        "achievement",
        "task",
        "comment",
        "mention",
        "reply",
        "message",
        "bud",
        "campus",
        "marketplace",
        "library",
        "transport",
        "timetable",
        "wallet"
      ],
      "default": "system"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "link": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "Target user. Null/absent = broadcast visible to all users."
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "normal",
        "low",
        "silent"
      ],
      "default": "normal"
    },
    "category": {
      "type": "string",
      "enum": [
        "system",
        "bud",
        "study_group",
        "assignment",
        "campus",
        "opportunity",
        "achievement",
        "social",
        "emergency",
        "exam",
        "timetable",
        "event",
        "streak",
        "community",
        "career",
        "wallet",
        "marketplace",
        "message"
      ],
      "default": "system"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "dismissed": {
      "type": "boolean",
      "default": false
    },
    "snoozed_until": {
      "type": "string",
      "format": "date-time",
      "description": "When set to a future time, the notification is hidden from the user until this moment passes"
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "open_count": {
      "type": "number",
      "default": 0
    },
    "batch_key": {
      "type": "string"
    },
    "batch_count": {
      "type": "number",
      "default": 1
    },
    "source": {
      "type": "string"
    },
    "action": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.user_id": {
            "$exists": false
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}