{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "academic",
        "social",
        "opportunity",
        "system",
        "emergency",
        "reminder",
        "achievement"
      ],
      "default": "system"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "link": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "When set, this notification is targeted to a specific user. When null, it is a broadcast notification visible to all users."
    }
  },
  "required": [
    "title",
    "message"
  ]
}