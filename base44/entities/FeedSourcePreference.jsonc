{
  "name": "FeedSourcePreference",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "campus",
        "friends",
        "communities",
        "following",
        "music",
        "videos",
        "news",
        "events",
        "bud_recommendations"
      ],
      "description": "Feed source identifier within the unified UNIBUD feed"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this source appears in the student's feed"
    },
    "muted": {
      "type": "boolean",
      "default": false,
      "description": "Temporarily muted \u2014 content hidden but source stays connected"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order \u2014 lower numbers appear higher in the feed"
    },
    "platforms_hidden": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specific connected platforms hidden from this source (e.g. ['instagram', 'tiktok'])"
    },
    "auto_sync": {
      "type": "boolean",
      "default": true,
      "description": "Whether content from this source syncs automatically"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "source"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}