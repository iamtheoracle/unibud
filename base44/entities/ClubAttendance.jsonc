{
  "name": "ClubAttendance",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "Reference to the Club"
    },
    "club_name": {
      "type": "string"
    },
    "meeting_title": {
      "type": "string",
      "description": "Name of the meeting or session"
    },
    "meeting_date": {
      "type": "string",
      "format": "date"
    },
    "meeting_type": {
      "type": "string",
      "enum": [
        "general",
        "executive",
        "event",
        "practice",
        "emergency",
        "agm"
      ],
      "default": "general"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "present",
              "absent",
              "late",
              "excused"
            ],
            "default": "present"
          },
          "check_in_time": {
            "type": "string"
          }
        }
      }
    },
    "total_present": {
      "type": "number",
      "default": 0
    },
    "total_absent": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "recorded_by_name": {
      "type": "string"
    },
    "recorded_by_id": {
      "type": "string"
    },
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    }
  },
  "required": [
    "club_id",
    "meeting_title",
    "meeting_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}