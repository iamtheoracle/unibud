{
  "name": "Staff",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "description": "Job title / position"
    },
    "type": {
      "type": "string",
      "enum": [
        "academic",
        "non_academic"
      ],
      "default": "academic"
    },
    "department": {
      "type": "string"
    },
    "employment_type": {
      "type": "string",
      "enum": [
        "full_time",
        "part_time",
        "contract",
        "visiting"
      ],
      "default": "full_time"
    },
    "workload": {
      "type": "number",
      "default": 0,
      "description": "Teaching hours / weekly load"
    },
    "leave_status": {
      "type": "string",
      "enum": [
        "active",
        "on_leave",
        "suspended"
      ],
      "default": "active"
    },
    "performance_rating": {
      "type": "number",
      "default": 0,
      "description": "0\u20135 scale"
    },
    "email": {
      "type": "string"
    },
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    }
  },
  "required": [
    "name",
    "institution_id"
  ],
  "rls": {
    "read": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "create": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "update": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "delete": {
      "data.institution_id": "{{user.data.institution_id}}"
    }
  }
}