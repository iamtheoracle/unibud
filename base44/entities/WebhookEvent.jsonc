{
  "name": "WebhookEvent",
  "type": "object",
  "properties": {
    "direction": {
      "type": "string",
      "enum": [
        "incoming",
        "outgoing"
      ],
      "default": "incoming"
    },
    "provider": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "signature": {
      "type": "string",
      "description": "Verified signature / secret hash"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "success",
        "retry",
        "dead_letter"
      ],
      "default": "pending"
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "response_code": {
      "type": "number"
    },
    "error": {
      "type": "string"
    },
    "next_retry_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "direction",
    "provider",
    "event_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}