{
  "name": "StudentRecord",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the User entity this record belongs to"
    },
    "full_name": {
      "type": "string",
      "description": "Student's display name for directory search"
    },
    "email": {
      "type": "string",
      "description": "Student email (masked in search results)"
    },
    "avatar_url": {
      "type": "string"
    },
    "matriculation_number": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "university": {
      "type": "string",
      "description": "University name for scoping and uniqueness"
    },
    "faculty": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "description": "e.g. 100, 200, 300, 400, 500"
    },
    "course_code": {
      "type": "string"
    },
    "matric_privacy": {
      "type": "string",
      "enum": [
        "public",
        "university_only",
        "connections_only",
        "private"
      ],
      "default": "university_only"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "enrollment_year": {
      "type": "number"
    },
    "expected_graduation": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "graduated",
        "suspended"
      ],
      "default": "active"
    },
    "last_active_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "full_name",
    "university"
  ],
  "rls": {
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}