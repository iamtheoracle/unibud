{
  "name": "ClubDiscussion",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "Reference to the Club"
    },
    "club_name": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Discussion title"
    },
    "body": {
      "type": "string",
      "description": "Discussion content"
    },
    "author_name": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "author_image": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "announcement",
        "question",
        "idea",
        "feedback",
        "event_planning"
      ],
      "default": "general"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs who liked this discussion"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "locked": {
      "type": "boolean",
      "default": false,
      "description": "No more replies can be added"
    },
    "views_count": {
      "type": "number",
      "default": 0
    },
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    }
  },
  "required": [
    "club_id",
    "title",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}