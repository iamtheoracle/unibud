{
  "name": "FriendRequest",
  "type": "object",
  "properties": {
    "recipient_id": {
      "type": "string",
      "description": "User id of the recipient"
    },
    "recipient_name": {
      "type": "string",
      "description": "Display name snapshot of the recipient"
    },
    "requester_name": {
      "type": "string",
      "description": "Display name snapshot of the requester"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "blocked"
      ],
      "default": "pending",
      "description": "pending = open request, accepted = friends, declined = rejected, blocked = requester blocked recipient"
    },
    "note": {
      "type": "string",
      "description": "Optional message sent with the request"
    }
  },
  "required": [
    "recipient_id",
    "recipient_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}