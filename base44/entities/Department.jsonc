{
  "name": "Department",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Official department name"
    },
    "code": {
      "type": "string",
      "description": "Department code or abbreviation"
    },
    "description": {
      "type": "string",
      "description": "Official department description"
    },
    "faculty_id": {
      "type": "string",
      "description": "Reference to the Faculty entity"
    },
    "faculty_name": {
      "type": "string",
      "description": "Denormalized faculty name"
    },
    "hod_name": {
      "type": "string",
      "description": "Head of Department name"
    },
    "hod_id": {
      "type": "string",
      "description": "User ID of the HOD"
    },
    "hod_educator_id": {
      "type": "string",
      "description": "Reference to Educator entity for the HoD"
    },
    "hod_image": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "color": {
      "type": "string",
      "description": "HSL color channels"
    },
    "established_year": {
      "type": "number"
    },
    "location": {
      "type": "string",
      "description": "Building or campus area"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "programs_offered": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Degree programmes offered (e.g. B.Sc Computer Science)"
    },
    "courses_count": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    }
  },
  "required": [
    "name",
    "institution_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "institution_owner"
              }
            },
            {
              "user_condition": {
                "role": "university_admin"
              }
            },
            {
              "user_condition": {
                "role": "registrar"
              }
            },
            {
              "user_condition": {
                "role": "dean"
              }
            },
            {
              "user_condition": {
                "role": "head_of_department"
              }
            },
            {
              "user_condition": {
                "role": "platform_admin"
              }
            },
            {
              "user_condition": {
                "role": "super_admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.institution_id": "{{user.data.institution_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "institution_owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "university_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "registrar"
                  }
                },
                {
                  "user_condition": {
                    "role": "dean"
                  }
                },
                {
                  "user_condition": {
                    "role": "head_of_department"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.institution_id": "{{user.data.institution_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "institution_owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "university_admin"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}