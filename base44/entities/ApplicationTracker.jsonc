{
  "name": "ApplicationTracker",
  "type": "object",
  "properties": {
    "opportunity_title": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "scholarship",
        "internship",
        "job",
        "competition",
        "exchange",
        "research",
        "grant",
        "fellowship",
        "volunteering",
        "mentorship"
      ],
      "default": "scholarship"
    },
    "status": {
      "type": "string",
      "enum": [
        "interested",
        "preparing",
        "applied",
        "interview",
        "offered",
        "rejected",
        "withdrawn"
      ],
      "default": "interested"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "progress": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "opportunity_title",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}