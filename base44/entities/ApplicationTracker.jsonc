{
  "name": "ApplicationTracker",
  "type": "object",
  "properties": {
    "opportunity_id": {
      "type": "string",
      "description": "Reference to the Opportunity entity"
    },
    "opportunity_title": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "scholarship",
        "internship",
        "job",
        "graduate_job",
        "campus_job",
        "competition",
        "hackathon",
        "exchange",
        "research",
        "grant",
        "fellowship",
        "volunteering",
        "mentorship"
      ],
      "default": "internship"
    },
    "status": {
      "type": "string",
      "enum": [
        "interested",
        "preparing",
        "applied",
        "interview",
        "offered",
        "rejected",
        "withdrawn"
      ],
      "default": "interested"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "resume_url": {
      "type": "string",
      "description": "URL of the resume attached to this application"
    },
    "resume_name": {
      "type": "string"
    },
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    }
  },
  "required": [
    "opportunity_title",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}