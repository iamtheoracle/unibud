{
  "name": "QuadPost",
  "type": "object",
  "properties": {
    "content": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_image": {
      "type": "string"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "student",
        "lecturer",
        "admin",
        "club"
      ],
      "default": "student"
    },
    "type": {
      "type": "string",
      "enum": [
        "post",
        "discussion",
        "poll",
        "event",
        "news",
        "achievement"
      ],
      "default": "post"
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "community": {
      "type": "string"
    },
    "likes_count": {
      "type": "number",
      "default": 0
    },
    "comments_count": {
      "type": "number",
      "default": 0
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "content",
    "author_name"
  ]
}