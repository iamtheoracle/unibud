{
  "name": "AcademicCalendarEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Details about this calendar event"
    },
    "type": {
      "type": "string",
      "enum": [
        "semester_start",
        "semester_end",
        "registration",
        "add_drop",
        "exam_period",
        "holiday",
        "orientation",
        "matriculation",
        "convocation",
        "break",
        "deadline",
        "result_release",
        "resumption",
        "other"
      ],
      "default": "other",
      "description": "Type of academic calendar event"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "is_all_day": {
      "type": "boolean",
      "default": true
    },
    "academic_session": {
      "type": "string",
      "description": "e.g. 2024/2025"
    },
    "semester": {
      "type": "string",
      "description": "e.g. First Semester, Harmattan, Rain"
    },
    "location": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "link_url": {
      "type": "string",
      "description": "Registration or info link"
    },
    "is_verified": {
      "type": "boolean",
      "default": true,
      "description": "Officially verified by institution"
    },
    "issued_by_name": {
      "type": "string"
    },
    "issued_by_id": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    }
  },
  "required": [
    "title",
    "type",
    "start_date",
    "institution_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "institution_owner"
              }
            },
            {
              "user_condition": {
                "role": "university_admin"
              }
            },
            {
              "user_condition": {
                "role": "registrar"
              }
            },
            {
              "user_condition": {
                "role": "platform_admin"
              }
            },
            {
              "user_condition": {
                "role": "super_admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.institution_id": "{{user.data.institution_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "institution_owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "university_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "registrar"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.institution_id": "{{user.data.institution_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "institution_owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "university_admin"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}