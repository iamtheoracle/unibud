{
  "name": "Device",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id"
    },
    "user_name": {
      "type": "string"
    },
    "device_name": {
      "type": "string"
    },
    "os": {
      "type": "string"
    },
    "browser": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "last_active": {
      "type": "string",
      "format": "date-time"
    },
    "is_trusted": {
      "type": "boolean",
      "default": false
    },
    "is_current": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "device_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}