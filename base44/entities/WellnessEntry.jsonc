{
  "name": "WellnessEntry",
  "type": "object",
  "properties": {
    "entry_type": {
      "type": "string",
      "enum": [
        "mood",
        "journal",
        "bud_conversation"
      ],
      "default": "mood"
    },
    "mood": {
      "type": "string",
      "enum": [
        "great",
        "good",
        "okay",
        "low",
        "struggling"
      ],
      "default": "okay"
    },
    "mood_score": {
      "type": "number",
      "default": 3
    },
    "energy_level": {
      "type": "number",
      "default": 3
    },
    "stress_level": {
      "type": "number",
      "default": 3
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_private": {
      "type": "boolean",
      "default": true
    },
    "bud_response": {
      "type": "string"
    },
    "entry_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "entry_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}