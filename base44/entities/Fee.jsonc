{
  "name": "Fee",
  "type": "object",
  "properties": {
    "student_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "tuition",
        "fee",
        "scholarship",
        "discount",
        "refund"
      ],
      "default": "tuition"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "overdue",
        "approved",
        "rejected",
        "refunded"
      ],
      "default": "pending"
    },
    "term": {
      "type": "string",
      "description": "Academic session / semester"
    },
    "description": {
      "type": "string"
    },
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    }
  },
  "required": [
    "student_name",
    "type",
    "institution_id"
  ],
  "rls": {
    "read": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "create": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "update": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "delete": {
      "data.institution_id": "{{user.data.institution_id}}"
    }
  }
}