{
  "name": "FeeStructure",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "tuition",
        "school",
        "hostel",
        "acceptance",
        "examination",
        "library",
        "other"
      ],
      "default": "tuition"
    },
    "name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "session": {
      "type": "string",
      "description": "Academic session"
    },
    "department": {
      "type": "string"
    },
    "installment_plan": {
      "type": "string"
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "waiver": {
      "type": "boolean",
      "default": false
    },
    "late_fee": {
      "type": "number",
      "default": 0
    },
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    }
  },
  "required": [
    "category",
    "name",
    "amount",
    "institution_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}