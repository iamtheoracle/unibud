{
  "name": "Assignment",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "course_code": {
      "type": "string"
    },
    "course_title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "submitted",
        "graded",
        "late"
      ],
      "default": "pending"
    },
    "type": {
      "type": "string",
      "enum": [
        "assignment",
        "quiz",
        "exam",
        "lab",
        "project"
      ],
      "default": "assignment"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "submission_type": {
      "type": "string",
      "enum": [
        "file",
        "online",
        "in_person",
        "presentation"
      ],
      "default": "file"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "submission_url": {
      "type": "string"
    },
    "grade": {
      "type": "number"
    },
    "max_grade": {
      "type": "number",
      "default": 100
    }
  },
  "required": [
    "title",
    "course_code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}