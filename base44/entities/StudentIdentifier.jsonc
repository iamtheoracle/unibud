{
  "name": "StudentIdentifier",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the User entity this identifier belongs to"
    },
    "institution_name": {
      "type": "string",
      "description": "Institution name for scoping"
    },
    "identifier_type": {
      "type": "string",
      "enum": [
        "admission_number",
        "application_number",
        "registration_number",
        "student_number",
        "matriculation_number",
        "student_id",
        "temporary_student_id",
        "email",
        "institution_specific"
      ],
      "default": "student_id"
    },
    "identifier_label": {
      "type": "string"
    },
    "identifier_value": {
      "type": "string"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by_id": {
      "type": "string"
    },
    "verification_method": {
      "type": "string",
      "enum": [
        "email",
        "institution_admin",
        "sync_service",
        "document",
        "manual"
      ],
      "default": "manual"
    },
    "is_primary": {
      "type": "boolean",
      "default": false
    },
    "is_permanent": {
      "type": "boolean",
      "default": false
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "institution_name",
    "identifier_type",
    "identifier_value"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}