{
  "name": "StudentIdentifier",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the User entity this identifier belongs to"
    },
    "institution_name": {
      "type": "string",
      "description": "Institution name for scoping"
    },
    "identifier_type": {
      "type": "string",
      "enum": [
        "admission_number",
        "application_number",
        "registration_number",
        "student_number",
        "matriculation_number",
        "student_id",
        "temporary_student_id",
        "email",
        "institution_specific"
      ],
      "default": "student_id"
    },
    "identifier_label": {
      "type": "string",
      "description": "Institution-specific label for this identifier type"
    },
    "identifier_value": {
      "type": "string",
      "description": "The actual identifier value"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether this identifier has been verified by the institution"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by_id": {
      "type": "string",
      "description": "User ID of the admin who verified this identifier"
    },
    "verification_method": {
      "type": "string",
      "enum": [
        "email",
        "institution_admin",
        "sync_service",
        "document",
        "manual"
      ],
      "default": "manual"
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the student's primary identifier for display"
    },
    "is_permanent": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the institution's permanent identifier (vs temporary)"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the institution issued this identifier to the student"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "institution_name",
    "identifier_type",
    "identifier_value"
  ]
}