{
  "name": "InstitutionOutreach",
  "type": "object",
  "properties": {
    "institution_name": {
      "type": "string"
    },
    "institution_type": {
      "type": "string",
      "enum": [
        "university",
        "polytechnic",
        "college_of_education",
        "technical_institute",
        "higher_college",
        "community_college",
        "other"
      ],
      "default": "university"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_role": {
      "type": "string",
      "description": "e.g. Vice-Chancellor, Registrar, Dean of Student Affairs, IT Director"
    },
    "outreach_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "responded",
        "accepted",
        "declined",
        "expired"
      ],
      "default": "pending"
    },
    "invitation_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "response_at": {
      "type": "string",
      "format": "date-time"
    },
    "onboarded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the institution completed onboarding and gained access to the Institution Configuration Center"
    },
    "sent_by_id": {
      "type": "string",
      "description": "User ID of the platform admin who sent the invitation"
    },
    "sent_by_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "estimated_student_count": {
      "type": "number"
    },
    "invitation_message": {
      "type": "string",
      "description": "Custom message included in the invitation email"
    }
  },
  "required": [
    "institution_name",
    "contact_email"
  ]
}