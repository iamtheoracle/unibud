{
  "name": "Follow",
  "type": "object",
  "properties": {
    "follower_id": {
      "type": "string",
      "description": "User ID of the follower"
    },
    "follower_name": {
      "type": "string",
      "description": "Display name of the follower (denormalized)"
    },
    "follower_image": {
      "type": "string"
    },
    "following_id": {
      "type": "string",
      "description": "User ID of the user being followed"
    },
    "following_name": {
      "type": "string",
      "description": "Display name of the followed user (denormalized)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "muted",
        "blocked"
      ],
      "default": "active"
    }
  },
  "required": [
    "follower_id",
    "following_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.follower_id": "{{user.id}}"
        },
        {
          "data.following_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.follower_id": "{{user.id}}"
    },
    "update": {
      "data.follower_id": "{{user.id}}"
    },
    "delete": {
      "data.follower_id": "{{user.id}}"
    }
  }
}