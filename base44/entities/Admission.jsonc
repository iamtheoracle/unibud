{
  "name": "Admission",
  "type": "object",
  "properties": {
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    },
    "applicant_name": {
      "type": "string"
    },
    "applicant_email": {
      "type": "string"
    },
    "programme": {
      "type": "string"
    },
    "applied_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "under_review",
        "offered",
        "accepted",
        "rejected",
        "waitlisted"
      ],
      "default": "submitted"
    },
    "documents_verified": {
      "type": "boolean",
      "default": false
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewer_notes": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "applicant_name",
    "institution_id"
  ],
  "rls": {
    "read": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "create": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "update": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "delete": {
      "data.institution_id": "{{user.data.institution_id}}"
    }
  }
}