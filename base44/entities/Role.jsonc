{
  "name": "Role",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "key": {
      "type": "string",
      "description": "Slug key, e.g. registrar, dean, operator"
    },
    "description": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "system",
        "institution"
      ],
      "default": "institution"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Granular permission keys"
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "Built-in roles cannot be deleted"
    },
    "institution_id": {
      "type": "string",
      "description": "Tenant scope for institution roles"
    }
  },
  "required": [
    "name",
    "key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.is_system": false
        }
      ]
    }
  }
}