{
  "name": "VerificationRequest",
  "type": "object",
  "properties": {
    "target_type": {
      "type": "string",
      "enum": [
        "listing",
        "community",
        "club",
        "study_group",
        "user",
        "student_id",
        "student_leader",
        "lecturer",
        "department",
        "faculty",
        "university",
        "business"
      ],
      "description": "What is being verified. Campus identity types drive the Identity hub."
    },
    "target_id": {
      "type": "string"
    },
    "target_name": {
      "type": "string"
    },
    "requester_id": {
      "type": "string"
    },
    "requester_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired",
        "renewal"
      ],
      "default": "pending"
    },
    "evidence_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by_id": {
      "type": "string"
    },
    "reviewer_notes": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Verification expiry \u2014 renewal required after this date"
    }
  },
  "required": [
    "target_type",
    "target_id",
    "requester_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.requester_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.requester_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}