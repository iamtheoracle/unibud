{
  "name": "Note",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "note_type": {
      "type": "string",
      "enum": [
        "text",
        "voice",
        "image",
        "handwritten",
        "scanned"
      ],
      "default": "text"
    },
    "course_code": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_module": {
      "type": "string",
      "enum": [
        "academics",
        "connect",
        "marketplace",
        "wallet",
        "news",
        "knowledge",
        "other"
      ],
      "default": "academics"
    },
    "summary": {
      "type": "string",
      "description": "AI-generated summary (Spark)"
    },
    "key_concepts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_indexed": {
      "type": "boolean",
      "default": false
    },
    "is_bookmarked": {
      "type": "boolean",
      "default": false
    },
    "folder_id": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}