{
  "name": "ExamSchedule",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Exam title"
    },
    "course_code": {
      "type": "string",
      "description": "Course code"
    },
    "course_title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "midterm",
        "final",
        "quiz",
        "practical",
        "oral",
        "makeup",
        "resit"
      ],
      "default": "final"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string",
      "description": "HH:MM"
    },
    "end_time": {
      "type": "string",
      "description": "HH:MM"
    },
    "duration_minutes": {
      "type": "number"
    },
    "venue": {
      "type": "string",
      "description": "Examination hall or room"
    },
    "location": {
      "type": "string",
      "description": "Building or campus area"
    },
    "seat_number": {
      "type": "string"
    },
    "faculty_id": {
      "type": "string"
    },
    "faculty_name": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "department_name": {
      "type": "string"
    },
    "academic_session": {
      "type": "string",
      "description": "e.g. 2024/2025"
    },
    "semester": {
      "type": "string"
    },
    "instructions": {
      "type": "string",
      "description": "Exam day instructions for students"
    },
    "allowed_materials": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "e.g. Calculator, Open book"
    },
    "is_verified": {
      "type": "boolean",
      "default": true,
      "description": "Officially published by institution"
    },
    "issued_by_name": {
      "type": "string"
    },
    "issued_by_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled",
        "postponed"
      ],
      "default": "scheduled"
    },
    "color": {
      "type": "string"
    },
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    }
  },
  "required": [
    "title",
    "date",
    "institution_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "institution_owner"
              }
            },
            {
              "user_condition": {
                "role": "university_admin"
              }
            },
            {
              "user_condition": {
                "role": "registrar"
              }
            },
            {
              "user_condition": {
                "role": "dean"
              }
            },
            {
              "user_condition": {
                "role": "head_of_department"
              }
            },
            {
              "user_condition": {
                "role": "lecturer"
              }
            },
            {
              "user_condition": {
                "role": "platform_admin"
              }
            },
            {
              "user_condition": {
                "role": "super_admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.institution_id": "{{user.data.institution_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "institution_owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "university_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "registrar"
                  }
                },
                {
                  "user_condition": {
                    "role": "dean"
                  }
                },
                {
                  "user_condition": {
                    "role": "head_of_department"
                  }
                },
                {
                  "user_condition": {
                    "role": "lecturer"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.institution_id": "{{user.data.institution_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "institution_owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "university_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "registrar"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}