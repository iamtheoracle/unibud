{
  "name": "ExamAttempt",
  "type": "object",
  "properties": {
    "paper_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "completed",
        "abandoned"
      ],
      "default": "in_progress"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      }
    },
    "score": {
      "type": "number",
      "default": 0
    },
    "total_marks": {
      "type": "number",
      "default": 0
    },
    "score_percent": {
      "type": "number",
      "default": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number",
      "default": 0
    },
    "is_proctored": {
      "type": "boolean",
      "default": false
    },
    "randomization_seed": {
      "type": "number",
      "default": 0
    },
    "proctor_flags": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "paper_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}