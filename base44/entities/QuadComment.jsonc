{
  "name": "QuadComment",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "ID of the QuadPost this comment belongs to (for quad post comments)"
    },
    "collection_id": {
      "type": "string",
      "description": "Collection/folder name for collection discussions"
    },
    "item_id": {
      "type": "string",
      "description": "Highlight item ID for per-item collection discussions (empty for collection-level)"
    },
    "content": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_image": {
      "type": "string"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "student",
        "lecturer",
        "admin",
        "club"
      ],
      "default": "student"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "parent_id": {
      "type": "string",
      "description": "Parent comment ID for nested replies; null/empty for top-level comments"
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "voice_url": {
      "type": "string",
      "description": "Voice reply audio URL (uploaded via UploadFile)"
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reactions": {
      "type": "object",
      "description": "Aggregate reaction counts: { like: 3, love: 1, ... }"
    },
    "likes_count": {
      "type": "number",
      "default": 0,
      "description": "Total reaction count"
    },
    "replies_count": {
      "type": "number",
      "default": 0
    },
    "is_edited": {
      "type": "boolean",
      "default": false
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    },
    "is_answered": {
      "type": "boolean",
      "default": false,
      "description": "Marked as answered by collection owner/manager"
    },
    "is_helpful": {
      "type": "boolean",
      "default": false,
      "description": "Marked as helpful by collection owner/manager"
    },
    "university": {
      "type": "string"
    }
  },
  "required": [
    "content",
    "author_name"
  ]
}