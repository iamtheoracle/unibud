{
  "name": "BudConversation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "context": {
      "type": "object",
      "description": "Structured conversation context (screen, user state, etc.)"
    },
    "user_id": {
      "type": "string",
      "description": "User this conversation belongs to (denormalized for fast filtering)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "deleted"
      ],
      "default": "active"
    },
    "course_code": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "study",
        "tutoring",
        "guidance",
        "general"
      ],
      "default": "general"
    },
    "summary": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "agents_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "message_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}