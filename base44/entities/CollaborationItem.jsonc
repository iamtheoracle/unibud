{
  "name": "CollaborationItem",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "note",
        "document",
        "whiteboard",
        "task",
        "checklist",
        "study_plan",
        "file"
      ],
      "default": "task"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Markdown/text for notes & documents; JSON string for whiteboard/checklist/study_plan"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Structured blocks for checklists [{text, done}], whiteboards [{x,y,text,color}], study plans [{week, goal, items[]}]"
    },
    "assignee_id": {
      "type": "string"
    },
    "assignee_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "blocked",
        "needs_review",
        "approved",
        "done"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_by_id": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "linked_resource_url": {
      "type": "string"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Synced from workspace for RLS"
    }
  },
  "required": [
    "workspace_id",
    "type",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}