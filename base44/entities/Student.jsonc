{
  "name": "Student",
  "type": "object",
  "description": "Student identity record. One identity per person; academic context is tracked via StudentContext.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the platform User entity"
    },
    "full_name": {
      "type": "string",
      "description": "Student full name"
    },
    "email": {
      "type": "string",
      "description": "Student email address"
    },
    "phone": {
      "type": "string",
      "description": "Student phone number"
    },
    "avatar_url": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other",
        "prefer_not_to_say"
      ],
      "default": "prefer_not_to_say"
    },
    "nationality": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended",
        "graduated",
        "withdrawn"
      ],
      "default": "active",
      "description": "Overall student platform status"
    },
    "registration_source": {
      "type": "string",
      "enum": [
        "self_registration",
        "invitation",
        "institution_import",
        "admin_created"
      ],
      "default": "self_registration"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name"
  ]
}