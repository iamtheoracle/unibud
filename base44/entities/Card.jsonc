{
  "name": "Card",
  "type": "object",
  "properties": {
    "wallet_id": {
      "type": "string"
    },
    "masked_number": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "virtual"
      ],
      "default": "virtual"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "frozen",
        "replaced"
      ],
      "default": "active"
    },
    "daily_limit": {
      "type": "number",
      "default": 100000
    },
    "monthly_limit": {
      "type": "number",
      "default": 500000
    },
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    }
  },
  "required": [
    "wallet_id",
    "masked_number",
    "institution_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}