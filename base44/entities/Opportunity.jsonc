{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "scholarship",
        "internship",
        "job",
        "competition",
        "exchange",
        "research",
        "grant",
        "fellowship",
        "volunteering",
        "mentorship"
      ],
      "default": "scholarship"
    },
    "description": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "location": {
      "type": "string"
    },
    "amount": {
      "type": "string"
    },
    "eligibility": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "is_saved": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}