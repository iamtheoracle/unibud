{
  "name": "Flashcard",
  "type": "object",
  "properties": {
    "front": {
      "type": "string"
    },
    "back": {
      "type": "string"
    },
    "deck": {
      "type": "string",
      "default": "General"
    },
    "course_code": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "default": "medium"
    },
    "image_url": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "favorite": {
      "type": "boolean",
      "default": false
    },
    "last_reviewed": {
      "type": "string",
      "format": "date-time"
    },
    "review_count": {
      "type": "number",
      "default": 0
    },
    "ease_factor": {
      "type": "number",
      "default": 2.5
    },
    "interval_days": {
      "type": "number",
      "default": 0
    },
    "due_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "front",
    "back"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}