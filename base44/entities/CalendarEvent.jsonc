{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "exam",
        "assignment",
        "class",
        "tradition",
        "study_session",
        "live_class",
        "personal",
        "deadline",
        "event",
        "mentorship"
      ],
      "default": "personal"
    },
    "source_entity": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "is_all_day": {
      "type": "boolean",
      "default": false
    },
    "color": {
      "type": "string"
    },
    "is_completed": {
      "type": "boolean",
      "default": false
    },
    "google_event_id": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "type",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}