{
  "name": "StudyGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "private",
        "public",
        "department",
        "faculty",
        "course",
        "exam_revision",
        "project_team"
      ],
      "default": "public"
    },
    "room_type": {
      "type": "string",
      "enum": [
        "voice",
        "video"
      ],
      "default": "video"
    },
    "host_name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "members_count": {
      "type": "number",
      "default": 0
    },
    "max_members": {
      "type": "number",
      "default": 50
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "scheduled",
        "ended"
      ],
      "default": "active"
    },
    "accent_color": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}