{
  "name": "ExternalContent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Headline of the external content"
    },
    "summary": {
      "type": "string",
      "description": "Bud-summarized version \u2014 never a verbatim copy of the original"
    },
    "body": {
      "type": "string",
      "description": "Full original text retained for reference; not displayed verbatim to students"
    },
    "provenance_type": {
      "type": "string",
      "enum": [
        "verified_external",
        "official_connected"
      ],
      "default": "verified_external",
      "description": "verified_external = temporary public source; official_connected = from an authenticated integration"
    },
    "source_label": {
      "type": "string",
      "enum": [
        "External Update",
        "Official Source",
        "Public Announcement",
        "Verified News"
      ],
      "default": "External Update",
      "description": "Clear provenance label shown to students"
    },
    "source_name": {
      "type": "string",
      "description": "Name of the external source (e.g. 'University Website', 'NUC')"
    },
    "source_url": {
      "type": "string",
      "description": "Direct link to original content"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "rss",
        "web_scrape",
        "official_api",
        "manual",
        "university_website",
        "public_database"
      ],
      "default": "web_scrape",
      "description": "How this content was collected"
    },
    "integration_status": {
      "type": "string",
      "enum": [
        "temporary_external",
        "official_api",
        "pending_transition",
        "migrated"
      ],
      "default": "temporary_external",
      "description": "Tracks the API transition lifecycle \u2014 temporary sources are replaced when official integrations connect"
    },
    "replaces_integration": {
      "type": "string",
      "description": "Integration type that will replace this temporary source (e.g. 'googlecalendar', 'instagram', 'linkedin', 'slack')"
    },
    "external_id": {
      "type": "string",
      "description": "ID from the external source for deduplication and transition matching"
    },
    "category": {
      "type": "string",
      "enum": [
        "news",
        "announcement",
        "event",
        "opportunity",
        "academic",
        "sports",
        "general",
        "emergency"
      ],
      "default": "general"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image_url": {
      "type": "string"
    },
    "author_name": {
      "type": "string",
      "description": "Original author or publisher name \u2014 never a UNIBUD student"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the content was originally published externally"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time",
      "description": "When UNIBUD collected this content"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Inactive when migrated or superseded by an official integration"
    },
    "bookmarked_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs who bookmarked \u2014 preserved during transition"
    },
    "reacted_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs who reacted \u2014 preserved during transition"
    },
    "reaction_count": {
      "type": "number",
      "default": 0
    },
    "discussion_count": {
      "type": "number",
      "default": 0,
      "description": "Community discussions about this content \u2014 separate from the external update itself"
    },
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    }
  },
  "required": [
    "title",
    "provenance_type",
    "source_label",
    "source_name",
    "institution_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}