{
  "name": "CollaborationVersion",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "snapshot": {
      "type": "object",
      "description": "{title, content, blocks, status} at this version"
    },
    "change_summary": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "workspace_id",
    "item_id",
    "version"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}