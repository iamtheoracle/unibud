{
  "name": "Faculty",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Official faculty name"
    },
    "code": {
      "type": "string",
      "description": "Faculty code or abbreviation"
    },
    "description": {
      "type": "string",
      "description": "Official description of the faculty"
    },
    "dean_name": {
      "type": "string",
      "description": "Name of the faculty dean"
    },
    "dean_id": {
      "type": "string",
      "description": "User ID of the dean"
    },
    "dean_image": {
      "type": "string"
    },
    "logo_url": {
      "type": "string",
      "description": "Faculty crest or logo"
    },
    "banner_url": {
      "type": "string"
    },
    "color": {
      "type": "string",
      "description": "HSL color channels for the faculty accent"
    },
    "established_year": {
      "type": "number"
    },
    "location": {
      "type": "string",
      "description": "Building or campus area"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "departments_count": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    }
  },
  "required": [
    "name",
    "institution_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "institution_owner"
              }
            },
            {
              "user_condition": {
                "role": "university_admin"
              }
            },
            {
              "user_condition": {
                "role": "registrar"
              }
            },
            {
              "user_condition": {
                "role": "platform_admin"
              }
            },
            {
              "user_condition": {
                "role": "super_admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.institution_id": "{{user.data.institution_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "institution_owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "university_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "registrar"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.institution_id": "{{user.data.institution_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "institution_owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "university_admin"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}