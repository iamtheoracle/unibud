{
  "name": "MarketplaceReview",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string",
      "description": "Reference to the MarketplaceListing this review is about"
    },
    "seller_id": {
      "type": "string",
      "description": "User id of the seller being rated (listing.created_by_id)"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Star rating from 1 to 5"
    },
    "comment": {
      "type": "string",
      "description": "Optional public note about the exchange"
    }
  },
  "required": [
    "listing_id",
    "seller_id",
    "rating"
  ],
  "rls": {
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}