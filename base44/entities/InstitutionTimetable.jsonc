{
  "name": "InstitutionTimetable",
  "type": "object",
  "properties": {
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    },
    "title": {
      "type": "string"
    },
    "course_code": {
      "type": "string"
    },
    "day": {
      "type": "string",
      "enum": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday"
      ],
      "default": "Monday"
    },
    "start_time": {
      "type": "string",
      "description": "HH:MM"
    },
    "end_time": {
      "type": "string",
      "description": "HH:MM"
    },
    "room": {
      "type": "string"
    },
    "lecturer": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "lecture",
        "lab",
        "tutorial",
        "seminar",
        "practical",
        "event"
      ],
      "default": "lecture"
    }
  },
  "required": [
    "institution_id",
    "title",
    "day",
    "start_time",
    "end_time"
  ],
  "rls": {
    "read": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "create": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "update": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "delete": {
      "data.institution_id": "{{user.data.institution_id}}"
    }
  }
}