{
  "name": "NotificationPreference",
  "type": "object",
  "properties": {
    "muted_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Notification types/categories the user has muted"
    },
    "quiet_hours_start": {
      "type": "string",
      "description": "HH:MM \u2014 non-critical notifications are delayed from this time"
    },
    "quiet_hours_end": {
      "type": "string",
      "description": "HH:MM \u2014 quiet hours end"
    },
    "digest_mode": {
      "type": "boolean",
      "default": true,
      "description": "Group low/normal non-urgent notifications into a daily digest"
    },
    "min_priority_to_alert": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "normal",
        "low"
      ],
      "default": "normal",
      "description": "Minimum priority that triggers an immediate alert"
    }
  },
  "required": [
    "digest_mode"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}