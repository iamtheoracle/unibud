{
  "name": "CrashReport",
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "description": "Short error headline / logger message"
    },
    "stack": {
      "type": "string",
      "description": "Stack trace or serialized context (truncated)"
    },
    "url": {
      "type": "string",
      "description": "Page URL where the crash occurred"
    },
    "user_agent": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "error",
        "warn",
        "info"
      ],
      "default": "error"
    },
    "context": {
      "type": "object",
      "description": "Structured context (componentStack, reason, file/line, etc.)"
    },
    "user_id": {
      "type": "string",
      "description": "Denormalized for fast per-user filtering (may be absent for anonymous crashes)"
    }
  },
  "required": [
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}