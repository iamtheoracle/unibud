{
  "name": "StudentDocument",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "pdf",
        "word",
        "powerpoint",
        "excel",
        "images",
        "voice_notes",
        "scanned_notes",
        "audio",
        "video",
        "text",
        "other"
      ],
      "default": "pdf"
    },
    "file_url": {
      "type": "string"
    },
    "file_type": {
      "type": "string"
    },
    "file_size": {
      "type": "number"
    },
    "original_filename": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "content_type": {
      "type": "string",
      "description": "MIME type"
    },
    "source_module": {
      "type": "string",
      "enum": [
        "academics",
        "connect",
        "marketplace",
        "wallet",
        "news",
        "knowledge",
        "other"
      ],
      "default": "knowledge",
      "description": "Which UNIBUD surface this file was saved from"
    },
    "summary": {
      "type": "string",
      "description": "AI-generated summary (Spark)"
    },
    "key_concepts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "AI-extracted concepts"
    },
    "suggested_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extracted_text": {
      "type": "string",
      "description": "Indexed full text for search (OCR / parsed)"
    },
    "ocr_text": {
      "type": "string",
      "description": "Text extracted from images/scans via OCR"
    },
    "ai_indexed": {
      "type": "boolean",
      "default": false
    },
    "indexed_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_bookmarked": {
      "type": "boolean",
      "default": false
    },
    "folder_id": {
      "type": "string",
      "description": "Collection id this file belongs to"
    }
  },
  "required": [
    "title",
    "category",
    "file_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}