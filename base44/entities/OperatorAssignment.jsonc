{
  "name": "OperatorAssignment",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "normal",
        "low"
      ],
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "assigned",
        "accepted",
        "in_progress",
        "paused",
        "waiting_review",
        "completed",
        "rejected",
        "archived"
      ],
      "default": "assigned"
    },
    "department": {
      "type": "string"
    },
    "operator_category": {
      "type": "string",
      "description": "Operator role type (e.g. Campus Support, ICT Support)"
    },
    "assigned_to_id": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "created_by_id": {
      "type": "string",
      "description": "Management user who created the assignment"
    },
    "created_by_name": {
      "type": "string"
    },
    "institution": {
      "type": "string"
    },
    "campus": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "related_people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file_url": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "photo",
              "video",
              "document",
              "voice",
              "file"
            ]
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author_id": {
            "type": "string"
          },
          "author_name": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "status_timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "by_id": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "reject_reason": {
      "type": "string"
    },
    "progress_percent": {
      "type": "number",
      "default": 0
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "paused_at": {
      "type": "string",
      "format": "date-time"
    },
    "completion_submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "status"
  ]
}