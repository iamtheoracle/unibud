{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "description": "The action performed (e.g. 'account_created', 'username_changed', 'profile_updated', 'university_changed', 'role_changed', 'verification_completed', 'account_suspended', 'account_restored')"
    },
    "actor_name": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "actor_role": {
      "type": "string"
    },
    "target_type": {
      "type": "string",
      "description": "What was affected (e.g. 'user', 'system', 'security', 'academic_record')"
    },
    "target_name": {
      "type": "string"
    },
    "target_user_id": {
      "type": "string",
      "description": "The user whose account was affected \u2014 enables per-user audit filtering"
    },
    "details": {
      "type": "string",
      "description": "Human-readable detail of the action"
    },
    "previous_value": {
      "type": "string",
      "description": "The value before the change (serialized JSON or plain text)"
    },
    "new_value": {
      "type": "string",
      "description": "The value after the change (serialized JSON or plain text)"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "info"
    },
    "meta": {
      "type": "object",
      "description": "Structured context (action context, metadata, etc.)"
    },
    "category": {
      "type": "string",
      "default": "system",
      "description": "Audit category (system, security, governance, account, academic, etc.)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "action"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}