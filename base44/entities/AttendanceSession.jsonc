{
  "name": "AttendanceSession",
  "type": "object",
  "properties": {
    "course_code": {
      "type": "string",
      "description": "Course code the session is for"
    },
    "course_title": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "description": "Short check-in code students enter or scan"
    },
    "lecturer_name": {
      "type": "string",
      "description": "Display name of the lecturer who opened the session"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the session auto-closes"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open"
    },
    "location": {
      "type": "string"
    },
    "late_after_minutes": {
      "type": "number",
      "default": 15,
      "description": "Check-ins after this many minutes are flagged late"
    },
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    }
  },
  "required": [
    "course_code",
    "code",
    "expires_at",
    "institution_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.status": "open"
            },
            {
              "data.institution_id": "{{user.data.institution_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}