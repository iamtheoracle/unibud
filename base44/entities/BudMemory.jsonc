{
  "name": "BudMemory",
  "type": "object",
  "properties": {
    "memory_type": {
      "type": "string",
      "enum": [
        "preference",
        "learning_style",
        "favorite_subject",
        "goal",
        "conversation",
        "fact",
        "episodic",
        "semantic",
        "procedural"
      ],
      "default": "fact",
      "description": "Type of memory: episodic (conversation-derived), semantic (facts/preferences), procedural (learned patterns), plus legacy types"
    },
    "content": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Where this memory was derived from"
    },
    "user_id": {
      "type": "string",
      "description": "User this memory belongs to (denormalized for fast filtering)"
    },
    "session_id": {
      "type": "string",
      "description": "Session or correlation id this memory was created in"
    },
    "metadata": {
      "type": "object",
      "description": "Structured metadata (response snippets, tags, etc.)"
    },
    "importance": {
      "type": "number",
      "default": 0.5,
      "description": "Importance score 0-1 (higher = more memorable)"
    }
  },
  "required": [
    "memory_type",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}