{
  "name": "GameRoom",
  "type": "object",
  "properties": {
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    },
    "title": {
      "type": "string"
    },
    "game_type": {
      "type": "string",
      "enum": [
        "chess",
        "checkers",
        "ludo",
        "scrabble",
        "sudoku",
        "word_games",
        "trivia",
        "quiz",
        "coding",
        "math",
        "science",
        "typing",
        "memory",
        "puzzle",
        "esports",
        "other"
      ],
      "default": "other",
      "description": "What game is being played"
    },
    "description": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "university",
        "community",
        "friends"
      ],
      "default": "public",
      "description": "Who can see and join this room"
    },
    "community_id": {
      "type": "string",
      "description": "Associated community if community room"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "waiting"
    },
    "max_participants": {
      "type": "number",
      "default": 2
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "is_online": {
            "type": "boolean",
            "default": true
          },
          "score": {
            "type": "number",
            "default": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "joined",
              "ready",
              "playing",
              "left",
              "spectating"
            ],
            "default": "joined"
          }
        }
      }
    },
    "spectators_count": {
      "type": "number",
      "default": 0
    },
    "voice_chat_enabled": {
      "type": "boolean",
      "default": false
    },
    "match_config": {
      "type": "object",
      "description": "Game-specific configuration (time control, difficulty, etc.)"
    },
    "winner_id": {
      "type": "string"
    },
    "university": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "game_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.visibility": "public"
        },
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}