{
  "name": "PodcastListen",
  "type": "object",
  "properties": {
    "episode_id": {
      "type": "string"
    },
    "podcast_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "Listener (denormalized for fast filtering)"
    },
    "position_seconds": {
      "type": "number",
      "default": 0
    },
    "duration_seconds": {
      "type": "number",
      "default": 0
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "last_played_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "episode_id",
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}