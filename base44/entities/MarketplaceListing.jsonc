{
  "name": "MarketplaceListing",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "is_free": {
      "type": "boolean",
      "default": false,
      "description": "When true the item is a free giveaway \u2014 no price expected."
    },
    "category": {
      "type": "string",
      "enum": [
        "textbooks",
        "electronics",
        "furniture",
        "accommodation",
        "tutoring",
        "services",
        "tickets",
        "other"
      ],
      "default": "other"
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "like_new",
        "good",
        "fair"
      ],
      "default": "good"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seller_name": {
      "type": "string"
    },
    "seller_image": {
      "type": "string"
    },
    "contact": {
      "type": "string",
      "description": "Phone, WhatsApp, or handle so buyers reach the seller directly \u2014 no payment integration required."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "sold",
        "reserved"
      ],
      "default": "active"
    },
    "location": {
      "type": "string"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "price"
  ]
}