{
  "name": "Enrollment",
  "type": "object",
  "description": "Enrollment record linking a student to a class, program, or course. Used in both university and learning organization ecosystems.",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "Reference to Student entity"
    },
    "student_name": {
      "type": "string",
      "description": "Denormalised student name"
    },
    "enrollment_type": {
      "type": "string",
      "enum": [
        "class",
        "program",
        "subject"
      ],
      "default": "class",
      "description": "What the student is enrolled in"
    },
    "class_id": {
      "type": "string",
      "description": "Reference to AcademicClass entity"
    },
    "academic_program_id": {
      "type": "string",
      "description": "Reference to AcademicProgram entity"
    },
    "subject_id": {
      "type": "string",
      "description": "Reference to Subject entity"
    },
    "context_type": {
      "type": "string",
      "enum": [
        "university",
        "learning_organization"
      ],
      "description": "Which ecosystem this enrollment belongs to"
    },
    "institution_id": {
      "type": "string",
      "description": "Reference to Institution or LearningOrganization"
    },
    "semester": {
      "type": "string"
    },
    "academic_year": {
      "type": "string"
    },
    "enrollment_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "completed",
        "withdrawn",
        "failed"
      ],
      "default": "active"
    },
    "grade": {
      "type": "string",
      "description": "Final grade awarded"
    },
    "score": {
      "type": "number",
      "description": "Numeric score"
    },
    "attendance_percentage": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "student_id",
    "enrollment_type"
  ]
}