{
  "name": "ClubFinance",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "Reference to the Club"
    },
    "club_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "description": "Whether money came in or went out"
    },
    "amount": {
      "type": "number",
      "description": "Amount in local currency"
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "category": {
      "type": "string",
      "enum": [
        "dues",
        "fundraiser",
        "event",
        "equipment",
        "venue",
        "refreshment",
        "prize",
        "transport",
        "sponsorship",
        "misc"
      ],
      "default": "misc",
      "description": "What the money was for"
    },
    "description": {
      "type": "string",
      "description": "Details about this transaction"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "receipt_url": {
      "type": "string",
      "description": "Uploaded receipt or proof of payment"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "approved"
    },
    "recorded_by_name": {
      "type": "string"
    },
    "recorded_by_id": {
      "type": "string"
    },
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    }
  },
  "required": [
    "club_id",
    "type",
    "amount",
    "category",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}