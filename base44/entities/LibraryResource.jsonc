{
  "name": "LibraryResource",
  "type": "object",
  "properties": {
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    },
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "book",
        "journal",
        "paper",
        "past_question",
        "lecture_note",
        "thesis"
      ],
      "default": "book"
    },
    "course_code": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "pages": {
      "type": "number"
    },
    "year": {
      "type": "number"
    },
    "publisher": {
      "type": "string"
    },
    "isbn": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_downloaded": {
      "type": "boolean",
      "default": false
    },
    "reading_progress": {
      "type": "number",
      "default": 0
    },
    "current_page": {
      "type": "number",
      "default": 0
    },
    "is_bookmarked": {
      "type": "boolean",
      "default": false
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "language": {
      "type": "string",
      "default": "English"
    },
    "accent_color": {
      "type": "string"
    },
    "available_copies": {
      "type": "number",
      "default": 1
    },
    "total_copies": {
      "type": "number",
      "default": 1
    },
    "shelf_location": {
      "type": "string",
      "description": "Physical location in library"
    }
  },
  "required": [
    "title",
    "type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}