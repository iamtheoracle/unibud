{
  "name": "EventUpdate",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID of the CampusEvent this update belongs to"
    },
    "title": {
      "type": "string",
      "description": "Short headline for the update"
    },
    "content": {
      "type": "string",
      "description": "Update message body"
    },
    "author_name": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean",
      "default": false,
      "description": "Pinned by organizer as important"
    },
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    }
  },
  "required": [
    "event_id",
    "content"
  ],
  "rls": {
    "read": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "create": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "update": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "delete": {
      "data.institution_id": "{{user.data.institution_id}}"
    }
  }
}