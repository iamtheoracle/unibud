{
  "name": "Institution",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Full official institution name"
    },
    "short_name": {
      "type": "string",
      "description": "Abbreviation or short name (e.g. UNIBEN, MIT, Oxford)"
    },
    "type": {
      "type": "string",
      "enum": [
        "university",
        "polytechnic",
        "college_of_education",
        "technical_institute",
        "higher_college",
        "community_college",
        "other"
      ],
      "default": "university",
      "description": "Type of higher education institution"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "banner_url": {
      "type": "string"
    },
    "accent_color": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Official institution description"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the institution has officially joined UNIBUD"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "community_supported",
        "awaiting_verification",
        "not_onboarded"
      ],
      "default": "not_onboarded",
      "description": "Institution onboarding status: verified = officially joined and manages data; community_supported = students active but institution not joined; awaiting_verification = invited and in onboarding; not_onboarded = not yet invited"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by_id": {
      "type": "string",
      "description": "User ID of the admin who completed verification"
    },
    "admin_contact_email": {
      "type": "string"
    },
    "admin_contact_name": {
      "type": "string"
    },
    "academic_structure": {
      "type": "object",
      "description": "Configurable academic hierarchy. Contains: organizational_units (faculties/schools/colleges with names and codes), departments, programmes, levels, semester_or_term (whether the institution uses semesters or terms)"
    },
    "identifier_types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "format_pattern": {
            "type": "string"
          },
          "format_example": {
            "type": "string"
          },
          "is_required_at_enrollment": {
            "type": "boolean"
          },
          "is_permanent": {
            "type": "boolean"
          },
          "verification_methods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "issued_timing": {
            "type": "string",
            "description": "When this identifier is issued: at_admission, at_registration, at_matriculation, at_enrollment, varies"
          }
        }
      },
      "description": "Configurable student identifier types with formats and verification rules"
    },
    "academic_calendar": {
      "type": "object",
      "description": "Configurable calendar: sessions, semesters or terms with start/end dates, registration periods, exam periods, holidays, orientation week, matriculation date, convocation date"
    },
    "admission_process": {
      "type": "object",
      "description": "Admission workflow configuration: application methods, entry requirements, admission timeline"
    },
    "registration_process": {
      "type": "object",
      "description": "Course registration workflow: registration periods, add/drop deadlines"
    },
    "orientation_process": {
      "type": "object",
      "description": "Orientation week configuration"
    },
    "matriculation_process": {
      "type": "object",
      "description": "When and how matriculation happens (if applicable). Includes: matriculation_timing (before_lectures, after_lectures, weeks_after_start, first_semester, second_semester, not_applicable), ceremony_details"
    },
    "convocation_process": {
      "type": "object"
    },
    "graduation_process": {
      "type": "object"
    },
    "credit_system": {
      "type": "string",
      "description": "e.g. credit_units, semester_hours, ECTS"
    },
    "grading_system": {
      "type": "object",
      "description": "Grade scale, GPA calculation method, pass threshold"
    },
    "terminology": {
      "type": "object",
      "description": "Institution-specific term mappings. e.g. { faculty: 'School', department: 'Programme', semester: 'Term', matriculation: 'Matric', course: 'Module' }"
    },
    "traditions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "student_organizations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "campus_locations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "hostels": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "emergency_contacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "important_links": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "student_handbook_url": {
      "type": "string"
    },
    "rules_and_regulations": {
      "type": "string"
    },
    "career_services": {
      "type": "object"
    },
    "branding": {
      "type": "object",
      "description": "Institution colors, logo variations, fonts"
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Where institution data comes from: verified_institution, official_sync, public_info, student_contributions, community_reports"
    },
    "estimated_student_count": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "type"
  ]
}