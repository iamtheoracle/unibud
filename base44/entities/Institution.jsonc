{
  "name": "Institution",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Full official institution name"
    },
    "short_name": {
      "type": "string",
      "description": "Abbreviation or short name (e.g. UNIBEN, MIT, Oxford)"
    },
    "type": {
      "type": "string",
      "enum": [
        "university",
        "private_university",
        "polytechnic",
        "college_of_education",
        "monotechnic",
        "nursing_school",
        "health_technology_school",
        "medical_college",
        "law_school",
        "technical_college",
        "vocational_school",
        "professional_training_institute",
        "research_institute",
        "secondary_school",
        "primary_school",
        "examination_body",
        "examination_center",
        "independent_learning_center",
        "online_academy",
        "corporate_training",
        "other"
      ],
      "default": "university",
      "description": "Type of higher education institution"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "banner_url": {
      "type": "string"
    },
    "accent_color": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Official institution description"
    },
    "motto": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the institution has officially joined UNIBUD"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "community_supported",
        "awaiting_verification",
        "not_onboarded"
      ],
      "default": "not_onboarded",
      "description": "Institution onboarding status"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by_id": {
      "type": "string",
      "description": "User ID of the admin who completed verification"
    },
    "admin_contact_email": {
      "type": "string"
    },
    "admin_contact_name": {
      "type": "string"
    },
    "academic_structure": {
      "type": "object",
      "description": "Configurable academic hierarchy: organizational_units, departments, programmes, levels, semester_or_term"
    },
    "identifier_types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "format_pattern": {
            "type": "string"
          },
          "format_example": {
            "type": "string"
          },
          "is_required_at_enrollment": {
            "type": "boolean"
          },
          "is_permanent": {
            "type": "boolean"
          },
          "verification_methods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "issued_timing": {
            "type": "string"
          }
        }
      },
      "description": "Configurable student identifier types with formats and verification rules"
    },
    "academic_calendar": {
      "type": "object",
      "description": "Sessions, semesters/terms with dates, registration, exam periods, holidays, orientation, matriculation, convocation"
    },
    "admission_process": {
      "type": "object",
      "description": "Application methods, entry requirements, admission timeline"
    },
    "registration_process": {
      "type": "object",
      "description": "Registration periods, add/drop deadlines"
    },
    "orientation_process": {
      "type": "object",
      "description": "Orientation week configuration"
    },
    "matriculation_process": {
      "type": "object",
      "description": "Matriculation timing and ceremony details"
    },
    "convocation_process": {
      "type": "object"
    },
    "graduation_process": {
      "type": "object"
    },
    "credit_system": {
      "type": "string",
      "description": "e.g. credit_units, semester_hours, ECTS"
    },
    "grading_system": {
      "type": "object",
      "description": "Grade scale, GPA calculation method, pass threshold"
    },
    "terminology": {
      "type": "object",
      "description": "Institution-specific term mappings"
    },
    "traditions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "student_organizations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "campus_locations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "hostels": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "emergency_contacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "important_links": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "student_handbook_url": {
      "type": "string"
    },
    "rules_and_regulations": {
      "type": "string"
    },
    "career_services": {
      "type": "object"
    },
    "branding": {
      "type": "object",
      "description": "Institution colors, logo variations, fonts"
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Where institution data comes from"
    },
    "estimated_student_count": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "id": "{{user.data.institution_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "university_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "institution_owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "dean"
                  }
                },
                {
                  "user_condition": {
                    "role": "registrar"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "id": "{{user.data.institution_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "university_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "institution_owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "dean"
                  }
                },
                {
                  "user_condition": {
                    "role": "registrar"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}