{
  "name": "TimetableEntry",
  "type": "object",
  "properties": {
    "course_code": {
      "type": "string"
    },
    "course_title": {
      "type": "string"
    },
    "day": {
      "type": "string",
      "enum": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday"
      ]
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "lecturer": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "lecture",
        "lab",
        "tutorial",
        "seminar"
      ],
      "default": "lecture"
    },
    "color": {
      "type": "string"
    }
  },
  "required": [
    "course_code",
    "course_title",
    "day",
    "start_time",
    "end_time"
  ]
}