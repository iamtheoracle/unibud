{
  "name": "InstitutionDocument",
  "type": "object",
  "properties": {
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "policy",
        "handbook",
        "calendar",
        "form",
        "letter",
        "template",
        "circular",
        "minutes",
        "accreditation",
        "report"
      ],
      "default": "policy"
    },
    "description": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "category": {
      "type": "string"
    }
  },
  "required": [
    "institution_id",
    "title",
    "type"
  ],
  "rls": {
    "read": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "create": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "update": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "delete": {
      "data.institution_id": "{{user.data.institution_id}}"
    }
  }
}