{
  "name": "Club",
  "type": "object",
  "properties": {
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    },
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier"
    },
    "description": {
      "type": "string"
    },
    "mission": {
      "type": "string",
      "description": "Club mission statement"
    },
    "category": {
      "type": "string",
      "enum": [
        "programming",
        "robotics",
        "photography",
        "entrepreneurship",
        "music",
        "debate",
        "sports",
        "volunteer",
        "innovation",
        "research",
        "drama",
        "dance",
        "journalism",
        "gaming",
        "art",
        "literary",
        "science",
        "other"
      ],
      "default": "other"
    },
    "university": {
      "type": "string"
    },
    "banner_url": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "accent_color": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name"
    },
    "president": {
      "type": "string"
    },
    "leadership": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        }
      }
    },
    "members_count": {
      "type": "number",
      "default": 0
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "member",
              "officer",
              "president",
              "vice_president",
              "secretary",
              "treasurer"
            ],
            "default": "member"
          },
          "joined_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "join_mode": {
      "type": "string",
      "enum": [
        "open",
        "request",
        "invite_only"
      ],
      "default": "open",
      "description": "How new members can join"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "is_official": {
      "type": "boolean",
      "default": false,
      "description": "Officially recognized by the university"
    },
    "is_recruiting": {
      "type": "boolean",
      "default": true
    },
    "founded_date": {
      "type": "string",
      "format": "date",
      "description": "When the club was founded"
    },
    "meeting_schedule": {
      "type": "string"
    },
    "meeting_day": {
      "type": "string",
      "description": "e.g. Fridays"
    },
    "meeting_time": {
      "type": "string",
      "description": "e.g. 16:00"
    },
    "meeting_location": {
      "type": "string"
    },
    "dues_amount": {
      "type": "number",
      "default": 0,
      "description": "Membership dues amount"
    },
    "dues_currency": {
      "type": "string",
      "default": "NGN"
    },
    "social_links": {
      "type": "object",
      "description": "{ website, instagram, twitter, linkedin }"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "read": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "create": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "update": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "delete": {
      "data.institution_id": "{{user.data.institution_id}}"
    }
  }
}