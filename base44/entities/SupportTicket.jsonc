{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "academic_stress",
        "homesickness",
        "loneliness",
        "exam_anxiety",
        "burnout",
        "motivation",
        "time_management",
        "financial_concerns",
        "relationship_challenges",
        "university_life",
        "technical",
        "general"
      ],
      "default": "general"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "escalated"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "student_name": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false
    },
    "resolution_notes": {
      "type": "string"
    }
  },
  "required": [
    "subject",
    "category"
  ]
}