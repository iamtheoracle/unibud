{
  "name": "ContentReport",
  "type": "object",
  "properties": {
    "content_type": {
      "type": "string",
      "enum": [
        "story",
        "short_video",
        "quad_post",
        "quad_comment",
        "short_video_comment",
        "marketplace_listing",
        "community",
        "club",
        "study_group",
        "review",
        "user"
      ],
      "description": "The type of content being reported"
    },
    "content_id": {
      "type": "string"
    },
    "reported_user_id": {
      "type": "string",
      "description": "User the report is attributed to (for trust scoring)"
    },
    "reported_user_name": {
      "type": "string"
    },
    "reporter_name": {
      "type": "string"
    },
    "reporter_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "spam",
        "duplicate",
        "offensive",
        "illegal",
        "malicious_link",
        "fake_university_info",
        "scam",
        "fake_listing",
        "counterfeit",
        "harassment",
        "inappropriate",
        "misinformation",
        "other"
      ],
      "description": "Moderation reason category"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewing",
        "actioned",
        "dismissed"
      ],
      "default": "pending"
    },
    "moderator_notes": {
      "type": "string"
    },
    "action_taken": {
      "type": "string",
      "enum": [
        "none",
        "warning",
        "content_removed",
        "user_suspended"
      ],
      "default": "none"
    }
  },
  "required": [
    "content_type",
    "content_id",
    "reporter_name",
    "reason"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.reporter_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}