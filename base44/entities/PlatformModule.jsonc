{
  "name": "PlatformModule",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique identifier (e.g., 'campus', 'quad', 'marketplace')"
    },
    "display_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "student_experience",
        "academic",
        "social",
        "opportunities",
        "campus_services",
        "wellbeing",
        "portals",
        "platform"
      ],
      "default": "student_experience"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "university_scope": {
      "type": "string",
      "description": "null for global scope, or university name for scoped module"
    }
  },
  "required": [
    "key",
    "display_name",
    "category"
  ]
}