{
  "name": "CourseCatalogEntry",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Official course title"
    },
    "code": {
      "type": "string",
      "description": "Course code (e.g. CSC101)"
    },
    "description": {
      "type": "string",
      "description": "Official course description"
    },
    "credits": {
      "type": "number",
      "description": "Credit units or hours"
    },
    "credit_system": {
      "type": "string",
      "default": "credit_units",
      "description": "credit_units, semester_hours, ECTS"
    },
    "level": {
      "type": "string",
      "enum": [
        "100",
        "200",
        "300",
        "400",
        "500",
        "600",
        "700",
        "general"
      ],
      "default": "100"
    },
    "faculty_id": {
      "type": "string"
    },
    "faculty_name": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "department_name": {
      "type": "string"
    },
    "semester_offered": {
      "type": "string",
      "description": "e.g. First Semester, Both, Either"
    },
    "is_elective": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Course codes required first"
    },
    "corequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lecturer_name": {
      "type": "string"
    },
    "lecturer_id": {
      "type": "string"
    },
    "syllabus_url": {
      "type": "string"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key topics covered"
    },
    "assessment_breakdown": {
      "type": "string",
      "description": "e.g. 40% CA, 60% Exam"
    },
    "recommended_textbooks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "color": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "institution_id": {
      "type": "string",
      "description": "Tenant scope \u2014 Institution id"
    }
  },
  "required": [
    "title",
    "code",
    "institution_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "institution_owner"
              }
            },
            {
              "user_condition": {
                "role": "university_admin"
              }
            },
            {
              "user_condition": {
                "role": "registrar"
              }
            },
            {
              "user_condition": {
                "role": "dean"
              }
            },
            {
              "user_condition": {
                "role": "head_of_department"
              }
            },
            {
              "user_condition": {
                "role": "lecturer"
              }
            },
            {
              "user_condition": {
                "role": "platform_admin"
              }
            },
            {
              "user_condition": {
                "role": "super_admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.institution_id": "{{user.data.institution_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "institution_owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "university_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "registrar"
                  }
                },
                {
                  "user_condition": {
                    "role": "dean"
                  }
                },
                {
                  "user_condition": {
                    "role": "head_of_department"
                  }
                },
                {
                  "user_condition": {
                    "role": "lecturer"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.institution_id": "{{user.data.institution_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "institution_owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "university_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "registrar"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}