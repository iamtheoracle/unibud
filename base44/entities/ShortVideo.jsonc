{
  "name": "ShortVideo",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number",
      "default": 0
    },
    "category": {
      "type": "string",
      "enum": [
        "study_tips",
        "lecture_summary",
        "campus_news",
        "research",
        "innovation",
        "coding",
        "tutorial",
        "career_advice",
        "entrepreneurship",
        "student_project",
        "competition",
        "clubs",
        "events"
      ],
      "default": "tutorial"
    },
    "author_name": {
      "type": "string"
    },
    "author_image": {
      "type": "string"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "student",
        "lecturer",
        "admin",
        "club"
      ],
      "default": "student"
    },
    "author_handle": {
      "type": "string",
      "description": "Department \u00b7 Level or role descriptor"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "university": {
      "type": "string"
    },
    "faculty": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "course_code": {
      "type": "string"
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Array of { start_time, end_time, text } for accessibility captions"
    },
    "reactions": {
      "type": "object",
      "description": "Aggregate reaction counts: { like, celebrate, helpful, insightful }"
    },
    "likes_count": {
      "type": "number",
      "default": 0
    },
    "comments_count": {
      "type": "number",
      "default": 0
    },
    "shares_count": {
      "type": "number",
      "default": 0
    },
    "bookmarks_count": {
      "type": "number",
      "default": 0
    },
    "views_count": {
      "type": "number",
      "default": 0
    },
    "is_bookmarked": {
      "type": "boolean",
      "default": false
    },
    "is_following_creator": {
      "type": "boolean",
      "default": false
    },
    "accent_color": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "under_review",
        "removed",
        "scheduled"
      ],
      "default": "active"
    },
    "moderation_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uploaded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "video_url",
    "author_name",
    "category"
  ]
}