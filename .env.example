# Copy to .env for local development.
# Never put real credentials in this tracked template.
APP_ENV=development
# Separate least-privilege PostgreSQL login principals; do not use the migration owner.
UNIBUD_AUTH_DATABASE_URL=
UNIBUD_APP_DATABASE_URL=

# Generate independent cryptographically random keys (hex encoded) per environment.
# Database context HMAC key must also be provisioned to unibud_private.context_signing_keys.
UNIBUD_DB_CONTEXT_HMAC_KEY=
UNIBUD_IDENTITY_ENCRYPTION_KEY=
UNIBUD_IDENTITY_LOOKUP_HMAC_KEY=
UNIBUD_RATE_LIMIT_HMAC_KEY=
UNIBUD_VERIFICATION_HMAC_KEY=

# Private HTTP gateway that routes email and SMS verification to configured providers.
# The gateway must protect recipient/code data and must never log one-time codes.
UNIBUD_VERIFICATION_DELIVERY_URL=
UNIBUD_VERIFICATION_DELIVERY_TOKEN=

# Approved legal policy versions. Keep blank until reviewed and formally adopted.
UNIBUD_TERMS_VERSION=
UNIBUD_PRIVACY_VERSION=
ORACLE_ARC_BASE_URL=http://localhost:8100

# Operations MFA cryptography. Keep these backend-only and independently generated.
UNIBUD_OPERATIONS_MFA_SEED_ENCRYPTION_KEY=
UNIBUD_OPERATIONS_MFA_RECOVERY_HMAC_KEY=
UNIBUD_OPERATIONS_MFA_ASSERTION_HMAC_KEY=
UNIBUD_DB_SESSION_CONTEXT_HMAC_KEY=
# Optional versioned AES-256-GCM keyring for TOTP seed encryption rotation.
# JSON shape: {"activeKeyId":"key-2026-11","keys":[{"id":"key-2026-10","keyHex":"<64 hex chars>"},{"id":"key-2026-11","keyHex":"<64 hex chars>"}]}
# Keep UNIBUD_OPERATIONS_MFA_SEED_ENCRYPTION_KEY as the legacy v1 decrypt key
# until all existing v1 ciphertext has been migrated and independently verified.
UNIBUD_OPERATIONS_MFA_SEED_ENCRYPTION_KEYRING_JSON=

# Oracle Arc server-to-server integration.
# Set these only in the UNIBUD backend deployment environment/secret manager.
# ORACLE_ARC_API_URL is the versioned API base, e.g. http://localhost:8100/v1 locally.
ORACLE_ARC_API_URL=
ORACLE_ARC_MODEL=
# Secret: never expose with NEXT_PUBLIC_ or commit a real value.
ORACLE_ARC_API_KEY=

# Temporary backend operator gate for the integration diagnostics route.
# Provision a long random value in the deployment secret manager.
# This is not a substitute for the planned UNIBUD admin identity/RBAC system.
UNIBUD_INTEGRATION_ADMIN_TOKEN=
# Enable only after approved legal policies are published and versioned.
UNIBUD_ONBOARDING_POLICIES_APPROVED=false
UNIBUD_TERMS_VERSION=
UNIBUD_PRIVACY_VERSION=
NEXT_PUBLIC_UNIBUD_TERMS_VERSION=
NEXT_PUBLIC_UNIBUD_PRIVACY_VERSION=

# Flow recipient-reference encryption, lookup digest and PIN step-up HMAC keys (32 random bytes, hex).
# The PIN step-up HMAC key must also be provisioned in unibud_private.flow_pin_step_up_signing_keys.
UNIBUD_FLOW_DATA_ENCRYPTION_KEY=
UNIBUD_FLOW_LOOKUP_HMAC_KEY=
UNIBUD_FLOW_PIN_STEP_UP_HMAC_KEY=
