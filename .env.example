# Copy to .env for local development.
# Never put real credentials in this tracked template.
APP_ENV=development
DATABASE_URL=postgresql://unibud:unibud_dev_only@localhost:5432/unibud
ORACLE_ARC_BASE_URL=http://localhost:8100

# Oracle Arc server-to-server integration.
# Set these only in the UNIBUD backend deployment environment/secret manager.
# ORACLE_ARC_API_URL is the versioned API base, e.g. http://localhost:8100/v1 locally.
ORACLE_ARC_API_URL=
ORACLE_ARC_MODEL=
# Secret: never expose with NEXT_PUBLIC_ or commit a real value.
ORACLE_ARC_API_KEY=

# Temporary backend operator gate for the integration diagnostics route.
# Provision a long random value in the deployment secret manager.
# This is not a substitute for the planned UNIBUD admin identity/RBAC system.
UNIBUD_INTEGRATION_ADMIN_TOKEN=
